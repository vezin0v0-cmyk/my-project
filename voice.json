{
  "_info": "Голосовые команды Nova. Говори «Нова, …» — например «Нова, сверни все окна». Фразы пиши маленькими буквами, без запятых. Что умеет «do»: shutdown, restart, cancel, minimizeAll, restoreAll, closeWindow, closeAll, lock, volumeUp, volumeDown, mute. Свою команду можно сделать через «run» (программа или ссылка) или «keys» (сочетание клавиш, например win+shift+s).",
  "wakeWord": "нова",
  "delaySeconds": 15,
  "commands": [
    { "say": ["выключи компьютер", "выключи комп"], "do": "shutdown" },
    { "say": ["перезагрузка компьютера", "перезагрузить компьютер"], "do": "restart" },
    { "say": ["отмена", "отмени", "стоп"], "do": "cancel" },
    { "say": ["сверни все окна", "спрячь все окна", "покажи рабочий стол"], "do": "minimizeAll" },
    { "say": ["верни окна", "разверни окна"], "do": "restoreAll" },
    { "say": ["закрой окно"], "do": "closeWindow" },
    { "say": ["закрой все окна"], "do": "closeAll" },
    { "say": ["заблокируй компьютер"], "do": "lock" },
    { "say": ["громче", "сделай громче"], "do": "volumeUp" },
    { "say": ["тише", "сделай тише"], "do": "volumeDown" },
    { "say": ["выключи звук", "включи звук"], "do": "mute" },
    { "say": ["сделай скриншот", "скриншот"], "keys": "win+shift+s" },
    { "say": ["открой проводник"], "run": "explorer.exe" },
    { "say": ["открой диспетчер задач"], "run": "taskmgr.exe" },
    { "say": ["открой стим"], "run": "steam://open/main" }
  ]
}
