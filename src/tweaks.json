{
  "_info": "Описание всех настроек Nova: что делает каждая и что именно меняет в системе. Включать и выключать их нужно в config.json в корне проекта.",
  "tweaks": [
    {
      "id": "telemetry-off",
      "category": "privacy",
      "title": "Минимум телеметрии",
      "description": "Ставит минимальный уровень сбора данных и отключает службу телеметрии DiagTrack. На Home и Pro минимум — «обязательные данные», полный ноль бывает только на Enterprise.",
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": 0 },
        { "type": "service", "name": "DiagTrack", "startup": "Disabled" }
      ]
    },
    {
      "id": "ads-id-off",
      "category": "privacy",
      "title": "Без рекламного идентификатора",
      "description": "Приложения не получат идентификатор для персональной рекламы.",
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "kind": "DWord", "value": 1 }
      ]
    },
    {
      "id": "tailored-off",
      "category": "privacy",
      "title": "Без советов по данным диагностики",
      "description": "Microsoft не будет подбирать советы и рекламу на основе диагностических данных.",
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy", "name": "TailoredExperiencesWithDiagnosticDataEnabled", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "activity-history-off",
      "category": "privacy",
      "title": "Не собирать историю действий",
      "description": "Windows перестаёт записывать, какие программы и файлы ты открывал, и отправлять это в облако.",
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableActivityFeed", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "PublishUserActivities", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "UploadUserActivities", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "suggestions-off",
      "category": "privacy",
      "title": "Убрать рекламу и «советы» Windows",
      "description": "Выключает рекламу в «Пуске», автоустановку предлагаемых приложений, советы на экране блокировки, рекламу OneDrive в Проводнике и напоминания «давайте завершим настройку».",
      "restartExplorer": true,
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-310093Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338387Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338389Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353694Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353696Enabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowSyncProviderNotifications", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement", "name": "ScoobeSystemSettingEnabled", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "kind": "DWord", "value": 1 }
      ]
    },
    {
      "id": "web-search-off",
      "category": "privacy",
      "title": "Без Bing в поиске «Пуска»",
      "description": "Поиск в «Пуске» ищет только на компьютере и не отправляет запросы в интернет.",
      "restartExplorer": true,
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Policies\\Microsoft\\Windows\\Explorer", "name": "DisableSearchBoxSuggestions", "kind": "DWord", "value": 1 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BingSearchEnabled", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "copilot-off",
      "category": "privacy",
      "title": "Отключить Copilot",
      "description": "Выключает встроенный Copilot и убирает его кнопку. В новых версиях Copilot — отдельное приложение: его удаляет пункт Microsoft.Copilot в списке removeApps.",
      "restartExplorer": true,
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "kind": "DWord", "value": 1 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "kind": "DWord", "value": 1 },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "recall-off",
      "category": "privacy",
      "title": "Отключить Recall",
      "description": "Recall постоянно делает снимки экрана для поиска с ИИ. Настройка запрещает эту функцию.",
      "minBuild": 26100,
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "kind": "DWord", "value": 1 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "AllowRecallEnablement", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "feedback-off",
      "category": "privacy",
      "title": "Не просить отзывы",
      "description": "Windows перестаёт показывать окна с просьбой оценить систему.",
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Siuf\\Rules", "name": "NumberOfSIUFInPeriod", "kind": "DWord", "value": 0 },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "kind": "DWord", "value": 1 }
      ]
    },
    {
      "id": "update-sharing-off",
      "category": "privacy",
      "title": "Не раздавать обновления другим ПК",
      "description": "Обновления качаются только с серверов Microsoft, а твой интернет не тратится на раздачу чужим компьютерам.",
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "kind": "DWord", "value": 0 }
      ]
    },
    {
      "id": "telemetry-tasks-off",
      "category": "privacy",
      "title": "Отключить скрытые задачи сбора данных",
      "description": "Windows по расписанию запускает задачи, которые собирают данные о программах, дисках и использовании. Отключаем их и службу отправки (dmwappushservice).",
      "actions": [
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "Microsoft Compatibility Appraiser" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "ProgramDataUpdater" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "Consolidator" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "UsbCeip" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\DiskDiagnostic\\", "name": "Microsoft-Windows-DiskDiagnosticDataCollector" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\", "name": "DmClient" },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\", "name": "DmClientOnScenarioDownload" },
        { "type": "service", "name": "dmwappushservice", "startup": "Disabled" }
      ]
    },
    {
      "id": "error-reporting-off",
      "category": "privacy",
      "title": "Не отправлять отчёты об ошибках",
      "description": "Когда программа падает, Windows больше не отправляет отчёт в Microsoft и не держит для этого службу.",
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "kind": "DWord", "value": 1 },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Windows Error Reporting\\", "name": "QueueReporting" },
        { "type": "service", "name": "WerSvc", "startup": "Disabled" }
      ]
    },
    {
      "id": "sync-off",
